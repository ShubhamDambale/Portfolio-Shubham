# Copy to `.env` and fill in as needed. All are OPTIONAL — the site runs with none of them.

# Base path. Leave unset for a user site (https://<user>.github.io/).
# For a project page (https://<user>.github.io/<repo>/) set this to "/<repo>/".
# VITE_BASE=/portfolio-city/

# Privacy-friendly analytics (choose one). Nothing is loaded unless VITE_ANALYTICS is set,
# and never in dev builds.
# VITE_ANALYTICS=plausible
# VITE_ANALYTICS_DOMAIN=shubhamdambale.github.io

# VITE_ANALYTICS=umami
# VITE_ANALYTICS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_ANALYTICS_SRC=https://cloud.umami.is/script.js

# VITE_ANALYTICS=ga4
# VITE_ANALYTICS_ID=G-XXXXXXXXXX
